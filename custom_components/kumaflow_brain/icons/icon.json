{
  "services": {
    "generate_daily": "service:kumaflow_brain.generate_daily",
    "my_wave": "service:kumaflow_brain.my_wave",
    "start_scan": "service:kumaflow_brain.start_scan"
  },
  "entity": {
    "sensor": {
      "health": { "default": "mdi:heart-pulse" },
      "tracks": { "default": "mdi:music-note-multiple" },

      "library_progress": { "default": "mdi:folder-search" },
      "library_status": { "default": "mdi:state-machine" },
      "library_finished": { "default": "mdi:clock-check" },

      "analysis_progress": { "default": "mdi:waveform" },
      "analysis_status": { "default": "mdi:state-machine" },
      "analysis_finished": { "default": "mdi:clock-check" },

      "clap_progress": { "default": "mdi:brain" },
      "clap_status": { "default": "mdi:state-machine" },
      "clap_finished": { "default": "mdi:clock-check" },

      "lyrics_progress": { "default": "mdi:file-document-outline" },
      "lyrics_status": { "default": "mdi:state-machine" },
      "lyrics_finished": { "default": "mdi:clock-check" },

      "clusters_progress": { "default": "mdi:scatter-plot" },
      "clusters_status": { "default": "mdi:state-machine" },
      "clusters_finished": { "default": "mdi:clock-check" },

      "token_is_admin": { "default": "mdi:shield-key" }
    },
    "button": {
      "generate_daily": { "default": "mdi:playlist-plus" },
      "scan_library": { "default": "mdi:folder-search" },
      "run_analysis": { "default": "mdi:waveform" },
      "my_wave": { "default": "mdi:waves" }
    }
  }
}
